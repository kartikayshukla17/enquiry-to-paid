# Copy to agent/.env (gitignored) and fill in. Never commit real values. See docs/SETUP.md.

# Database (local Docker default shown; Supabase session pooler for the test project)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/e2p

# Local secrets: openssl rand -base64 32
PII_ENC_KEY=
PHONE_HASH_KEY=
BETTER_AUTH_SECRET=

# LLM
LLM_PROVIDER=fixture        # fixture | groq
LLM_MODE=replay             # replay | record | live
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REGION=us

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (test)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (T25)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Auth origins
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=   # comma-separated extra origins (tunnel, staging)

# Deployment (agent/src/server/serve.ts; not needed for local dev, where defaults are fine)
# AGENT_PORT=4010              # local only; Render/most PaaS hosts set PORT themselves
# PAYMENTS_PROVIDER=razorpay   # which configured provider new quotes use; default is razorpay if its keys are set, else razorpay-sim
