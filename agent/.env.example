# Copy to agent/.env (gitignored) and fill in. Never commit real values. See docs/SETUP.md.

# Database (local Docker default shown; Supabase session pooler for the test project)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/e2p

# Local secrets: openssl rand -base64 32
PII_ENC_KEY=
PHONE_HASH_KEY=
BETTER_AUTH_SECRET=

# LLM
LLM_PROVIDER=fixture        # fixture | groq
LLM_MODE=replay             # replay | record | live
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REGION=us
# V10: global, non-tenant daily ceiling on real Groq network calls (extract + wordReply together, every
# playground tenant shares one Groq API key). Default 950 is a safety margin under Groq's own documented
# free-tier "Developer" base limit for openai/gpt-oss-120b: 1,000 requests/day (RPD), read from
# https://console.groq.com/docs/rate-limits on 2026-11-11. Re-verify against the account's Limits page before
# a real deployment goes live with LLM_PROVIDER=groq — account-level limits can differ from the base table.
# Note: this is a REQUEST ceiling, not an ENQUIRY ceiling — one enquiry can cost up to 2 real Groq calls.
GROQ_DAILY_CEILING=950

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (test)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (V2): adapter built and tested; any var left blank just makes the handshake and
# the webhook signature check always fail closed (401/403), never a crash. See docs/SETUP.md section 5 for
# where to find each of these in Meta's dashboard and what to paste into "Configure Webhooks" once deployed.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Auth origins
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=   # comma-separated extra origins (tunnel, staging)

# Deployment (agent/src/server/serve.ts; not needed for local dev, where defaults are fine)
# AGENT_PORT=4010              # local only; Render/most PaaS hosts set PORT themselves
# PAYMENTS_PROVIDER=razorpay   # which configured provider new quotes use; default is razorpay if its keys are set, else razorpay-sim

# POST /tick (V7): shared secret the GitHub Actions schedule sends as "Authorization: Bearer <value>".
# Unset -> /tick always 401s. Set this before deploying, then set the same value as the TICK_SECRET repo
# secret (.github/workflows/tick.yml), alongside AGENT_TICK_URL (the deployed https://.../tick URL).
TICK_SECRET=
