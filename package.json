{
  "name": "enquiry-to-paid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint && pnpm lint:agent",
    "build:kernel": "cargo build --release --target wasm32-unknown-unknown --manifest-path kernel/Cargo.toml && node scripts/copy-kernel.mjs",
    "lint:agent": "pnpm --filter agent typecheck",
    "sim": "pnpm --filter agent sim",
    "sim:web": "pnpm --filter agent sim:web",
    "auth:web": "pnpm --filter agent auth:web",
    "db:setup": "pnpm --filter agent db:setup",
    "eval": "pnpm --filter agent eval",
    "provider": "pnpm --filter agent provider",
    "adversarial": "pnpm --filter agent adversarial",
    "ledger": "pnpm --filter agent ledger",
    "card": "pnpm --filter agent card",
    "test":"pnpm build:kernel && pnpm --filter agent test && cargo test --manifest-path kernel/Cargo.toml"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "15.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rough-notation": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
