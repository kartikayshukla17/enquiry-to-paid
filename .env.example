# Root site env (Next.js). Copy to .env.local for local overrides, or set in Vercel's project settings for deploys.
# Not needed locally: next.config.ts and the API routes default to http://127.0.0.1:4010 (pnpm serve).

# Public URL of the deployed agent server (e.g. a Render service). Vercel proxies /api/auth/* and
# /api/webhooks/payments/* to this URL server-side, so the browser only ever sees this site's own origin.
AGENT_URL=
